<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Float bawah-tengah: slider ANTREAN (T3-5): Ranked / Battle / 1 teaser (Faction War · Nexus Cup) + dots + SATU tombol utama.
         Rank/mode info kontekstual di atas MAIN. HQ & Plaza = tombol akses terpisah (bukan slider). -->
    <ui:VisualElement class="nxl-cta-float" name="center-cta" picking-mode="Ignore">
        <ui:VisualElement class="nxl-row" style="align-items: center;">

            <!-- Akses terpisah: HQ + Plaza (ukuran & gaya sama) -->
            <ui:VisualElement style="margin-right: 24px;">
                <ui:Button name="btn-hq" class="nxl-access-btn" tooltip="Squad HQ">
                    <ui:Label text="HQ" class="nxl-access-ic" />
                    <ui:Label text="HQ" class="nxl-access-lbl" />
                </ui:Button>
                <ui:Button name="btn-plaza" class="nxl-access-btn" tooltip="Plaza" style="margin-top: 8px;">
                    <ui:Label text="PZ" class="nxl-access-ic" />
                    <ui:Label text="PLAZA" class="nxl-access-lbl" />
                </ui:Button>
                <!-- T3-5: Street Room = room browser 1v1–3v3 tanpa MMR (tombol sendiri, bukan slider). -->
                <ui:Button name="btn-street" class="nxl-access-btn" tooltip="Street Room" style="margin-top: 8px;">
                    <ui:Label text="SR" class="nxl-access-ic" />
                    <ui:Label text="STREET" class="nxl-access-lbl" />
                </ui:Button>
            </ui:VisualElement>

            <!-- Panel mode -->
            <ui:VisualElement class="nxl-center" name="mode-col">
                <ui:VisualElement class="nxl-row nxl-center" name="mode-selector">
                    <ui:Button text="&lt;" name="mode-prev" class="nxl-icon-btn nxl-mode-arrow" />
                    <ui:Label text="RANKED" name="mode-title" class="nxl-h1" style="min-width: 300px; -unity-text-align: middle-center;" />
                    <ui:Button text="&gt;" name="mode-next" class="nxl-icon-btn nxl-mode-arrow" />
                </ui:VisualElement>

                <!-- Kontekstual: rank (mode Ranked) ATAU deskripsi mode -->
                <ui:VisualElement class="nxl-rankmini nxl-row nxl-center" name="rank-mini" style="margin-top: 6px;">
                    <ui:VisualElement name="rank-mini-emblem" class="nxl-emblem" />
                    <ui:VisualElement style="margin-left: 10px;">
                        <ui:Label text="UNRANKED" name="rank-tier" class="nxl-h2" style="font-size: 18px;" />
                        <ui:Label text="" name="rank-sub" class="nxl-dim" />
                        <ui:VisualElement class="nxl-rp-track" name="rank-mini-track" style="width: 180px; margin-top: 4px;">
                            <ui:VisualElement class="nxl-rp-fill" name="rank-mini-fill" style="width: 0%;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Casual · tanpa peringkat" name="mode-desc" class="nxl-dim nxl-hidden" style="margin-top: 6px; -unity-text-align: middle-center;" />

                <!-- Dots indikator jumlah/posisi mode -->
                <ui:VisualElement class="nxl-row nxl-center" style="margin-top: 8px;">
                    <ui:VisualElement class="nxl-dot" name="dot-0" />
                    <ui:VisualElement class="nxl-dot" name="dot-1" />
                    <ui:VisualElement class="nxl-dot" name="dot-2" />
                    <ui:VisualElement class="nxl-dot" name="dot-3" />
                </ui:VisualElement>

                <ui:Button text="MAIN" name="btn-primary" class="nxl-btn nxl-btn--orange nxl-btn--hero" style="width: 360px; height: 72px; margin-top: 12px;" />
                <ui:Button text="CREATE ROOM" name="btn-create-room" class="nxl-btn nxl-btn--green nxl-hidden" style="width: 220px; height: 48px; margin-top: 10px;" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
