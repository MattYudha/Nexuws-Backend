/* ============================================================
   NEXUS SAGA — Design tokens (warna, font). Didefinisikan di :root
   supaya SEMUA elemen (lobby, profil, party) bisa resolve var(--...).
   Muat file ini SEBELUM NexusLobby.uss di tiap UXML dokumen.
   Jangan pakai var() nested atau var() di inline style (bug UITK 2022).
   ============================================================ */
:root {
    --nxl-navy:       rgb(15, 30, 60);
    --nxl-navy-2:     rgb(10, 20, 44);
    --nxl-border:     rgb(58, 123, 213);
    --nxl-border-dim: rgb(42, 74, 122);
    --nxl-cyan:       rgb(79, 209, 255);
    --nxl-text:       rgb(255, 255, 255);
    --nxl-text-2:     rgb(168, 196, 232);
    --nxl-dim:        rgb(120, 146, 186);
    --nxl-gold:       rgb(245, 197, 66);
    --nxl-orange:     rgb(242, 140, 30);
    --nxl-green:      rgb(60, 176, 67);
    --nxl-red:        rgb(214, 72, 68);

    /* ========================================================
       TOKEN SEMANTIK (T1 — kunci arti warna; docs/90).
       SATU warna = SATU arti. Jangan pakai token faksi utk ini,
       dan jangan pakai token ini utk faksi.
       - team-ally  : tim kamu / kawan (BIRU, beda dari cyan=fokus)
       - team-enemy : lawan / musuh (MERAH — satu-satunya arti merah)
       - result-win : MENANG (alias emas rank)
       - result-loss: KALAH + delta negatif (ABU-BAJA, JANGAN merah) + art desaturate
       - gain       : perolehan positif (+Poin)
       - online     : status online (Fase 2 presence)
       - hero-neutral: placeholder hero netral (+ ikon kelas)
       Pemakaian: detail/scoreboard (kamu=ally, lawan=enemy), riwayat
       (KALAH=loss), Poin Ladder delta (+gain / −loss), titik online,
       placeholder hero. BUKAN utk badge/emblem faksi (lihat .nxl-facbadge).
       ======================================================== */
    --nx-team-ally:      rgb(64, 150, 255);
    --nx-team-ally-dim:  rgb(44, 104, 178);
    --nx-team-enemy:     rgb(240, 110, 110);
    --nx-team-enemy-dim: rgb(178, 72, 72);
    --nx-result-win:     rgb(245, 197, 66);   /* = --nxl-gold (emas rank + MENANG) */
    --nx-result-loss:    rgb(138, 152, 170);  /* abu-baja (steel), BUKAN merah */
    --nx-result-loss-dim:rgb(92, 104, 122);
    --nx-gain:           rgb(52, 211, 153);   /* hijau kebiruan (+Poin) */
    --nx-gain-dim:       rgb(34, 150, 108);
    --nx-online:         rgb(52, 211, 153);   /* status online (presence, Fase 2) */
    --nx-hero-neutral:   rgb(120, 130, 150);  /* placeholder hero netral */
    --nx-badge-bg:       rgb(78, 88, 104);    /* chip prestasi netral (steel-dim), dibedakan ikon+label */
    --nx-badge-fg:       rgb(236, 240, 248);  /* teks chip prestasi (putih) */

    /* Font (Google Fonts OFL) — judul/tombol = Chakra Petch, teks kecil = Exo 2 */
    --nxl-font-title: url("Fonts/ChakraPetch-Bold.ttf");
    --nxl-font-head:  url("Fonts/ChakraPetch-Bold.ttf");
    --nxl-font-body:  url("Fonts/Exo2-Variable.ttf");
}
